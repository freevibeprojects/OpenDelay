// Dashboard: hero delay value, main controls, buffer, stats, health.

import { Theme, Icons } from "../theme.slint";
import { Button, ButtonKind, IconButton, Card, Pill, ProgressBar, RollingNumber, StatCard, Select, Choice, Toggle, CopyField, TextField, Body, SectionTitle } from "../widgets.slint";
import { AppState, Strings } from "../state.slint";

// Delay in seconds: type a value (Enter or leaving the field applies it),
// nudge it by 5 s or pick a preset.
component DelayInput {
    property <int> backend: AppState.configured-delay-s;
    property <bool> editing: field.has-focus;
    accessible-role: spinbox;
    accessible-label: @tr("Delay in seconds");
    accessible-value: root.backend;
    accessible-action-increment => { root.nudge(5); }
    accessible-action-decrement => { root.nudge(-5); }

    init => { field.text = root.backend; }
    changed backend => {
        if (!root.editing) {
            field.text = root.backend;
        }
    }
    changed editing => {
        if (!root.editing) {
            root.apply(field.text);
        }
    }

    function apply(t: string) {
        if (t.is-float() && t.to-float() >= 1 && t.to-float() <= 600) {
            if (round(t.to-float()) != root.backend) {
                AppState.set-delay(round(t.to-float()));
            }
            field.text = round(t.to-float());
        } else {
            AppState.toast(@tr("Enter a delay from 1 to 600 seconds."), "warning");
            field.text = root.backend;
        }
    }

    // Applied on every click: while a switch is pending, another change only
    // moves its target, so quick clicks still make one jump.
    function nudge(d: int) {
        AppState.set-delay(clamp(root.backend + d, 1, 600));
        field.text = root.backend;
    }

    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            IconButton {
                icon: Icons.minus;
                label: @tr("5 seconds shorter");
                size: 38px;
                round: true;
                clicked => { root.nudge(-5); }
            }
            field := TextField {
                width: 84px;
                label: @tr("Delay in seconds");
                placeholder: @tr("seconds");
                accepted(t) => { root.apply(t); }
            }
            Text {
                text: @tr("s");
                color: Theme.text-secondary;
                font-size: 14px;
                vertical-alignment: center;
            }
            IconButton {
                icon: Icons.plus;
                label: @tr("5 seconds longer");
                size: 38px;
                round: true;
                clicked => { root.nudge(5); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for p in [5, 10, 15, 30, 60, 120, 300]: Button {
                text: Strings.duration(p);
                kind: root.backend == p ? ButtonKind.primary : ButtonKind.secondary;
                font-size: 13px;
                pad: 10px;
                clicked => {
                    field.text = p;
                    if (p != root.backend) {
                        AppState.set-delay(p);
                    }
                }
            }
        }
    }
}

export component DashboardPage {
    property <bool> active: AppState.delay-active;
    property <color> state-color: AppState.state == "live" ? Theme.success
        : AppState.state == "delayed" ? Theme.accent-hover
        : (AppState.state == "buffering" || AppState.state == "recovering") ? Theme.warning
        : AppState.state == "draining" ? Theme.success
        : Theme.text-secondary;

    VerticalLayout {
        spacing: 20px;

        if AppState.emergency: Rectangle {
            height: 60px;
            border-radius: Theme.radius-lg;
            background: Theme.error.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.error.with-alpha(0.5);
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Image { source: Icons.power; colorize: Theme.error; width: 20px; height: 20px; }
                }
                Text {
                    text: @tr("Emergency stop is active: encoders cannot publish until you allow streaming again.");
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Allow streaming");
                        clicked => { AppState.clear-emergency(); }
                    }
                }
            }
        }

        // Hero
        Card {
            min-height: 300px;
            VerticalLayout {
                padding: 28px;
                spacing: 6px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Pill {
                        text: Strings.state-label(AppState.state);
                        color: root.state-color;
                        pulse: AppState.state == "buffering" || AppState.state == "recovering" || AppState.state == "draining";
                    }
                }
                Rectangle {
                    height: 150px;
                    // soft glow behind the delayed value
                    glow := Rectangle {
                        width: 340px;
                        height: 150px;
                        border-radius: 75px;
                        background: @radial-gradient(circle, #7f63f066 0%, #7f63f000 70%);
                        opacity: root.active ? 1 : 0;
                        animate opacity { duration: Theme.normal; }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        RollingNumber {
                            value: root.active ? AppState.current-delay-s : AppState.configured-delay-s;
                            font-size: 116px;
                            // dimmed: the delay that would be used, not in effect yet
                            color: root.active ? Theme.hero-gradient : Theme.text-muted;
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: 26px;
                            Text {
                                text: @tr("s");
                                color: root.active ? Theme.accent-hover : Theme.text-secondary;
                                font-size: 34px;
                                font-weight: 600;
                            }
                        }
                    }
                }
                Text {
                    horizontal-alignment: center;
                    color: Theme.text-secondary;
                    font-size: 14px;
                    wrap: word-wrap;
                    text: AppState.state == "offline" ? @tr("Delay that will be used. Start streaming in your encoder to begin.")
                        : AppState.state == "connecting" ? @tr("Connecting to the platform…")
                        : AppState.state == "recovering" ? @tr("Reconnecting to the platform (attempt {})…", AppState.recovery-attempt)
                        : AppState.state == "buffering" ? @tr("Viewers are {} behind; they jump back {} at a keyframe once that much is buffered.", Strings.duration(AppState.current-delay-s), Strings.duration(AppState.target-delay-s))
                        : AppState.state == "draining" ? @tr("Switching at the next keyframe…")
                        : AppState.state == "delayed" && AppState.current-delay-s != AppState.target-delay-s ? @tr("Viewers are {} behind. Switching to {} at the next keyframe…", Strings.duration(AppState.current-delay-s), Strings.duration(AppState.target-delay-s))
                        : AppState.state == "delayed" ? @tr("Viewers are {} behind.", Strings.duration(AppState.current-delay-s))
                        : !AppState.delay-mode ? @tr("Viewers see you live. Turn on the delay buffer below to use the delay.")
                        : AppState.ready ? @tr("Viewers see you live. \"Enable delay\" puts them {} behind at once.", Strings.duration(AppState.configured-delay-s))
                        : @tr("Viewers see you live. The buffer is still filling; enabling now builds the delay up.");
                }
                if AppState.progress >= 0: HorizontalLayout {
                    alignment: center;
                    padding-top: 10px;
                    ProgressBar {
                        width: 280px;
                        value: AppState.progress;
                        color: AppState.state == "buffering" ? Theme.warning : Theme.success;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding-top: 18px;
                    Button {
                        text: root.active ? @tr("Disable delay") : @tr("Enable delay");
                        kind: ButtonKind.primary;
                        min-width: 180px;
                        font-size: 15px;
                        enabled: AppState.delay-mode && AppState.state != "draining";
                        clicked => {
                            if (root.active) {
                                AppState.go-live();
                            } else {
                                AppState.enable-delay();
                            }
                        }
                    }
                    // Only while delayed: a greyed "Go live" while already live looked broken.
                    if root.active: Button {
                        text: @tr("Go live");
                        show-icon: true;
                        icon: Icons.live;
                        enabled: AppState.state != "draining";
                        clicked => { AppState.go-live(); }
                    }
                }
            }
        }

        if AppState.state == "offline": Card {
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                SectionTitle { text: @tr("Waiting for your encoder"); }
                Body { text: @tr("In OBS (or any RTMP encoder) set the server to this address and keep your usual stream key:"); }
                CopyField {
                    value: AppState.encoder-url;
                    label: @tr("Server URL");
                    copied => { AppState.toast(@tr("Copied to the clipboard"), "success"); }
                }
                if AppState.encoder-refused != "": Text {
                    text: @tr("Your encoder was turned away: {}", AppState.encoder-refused);
                    color: Theme.error;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }

        // Controls
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: @tr("Delay"); color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                        DelayInput { }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: @tr("Buffer length"); color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                        Select {
                            label: @tr("Buffer length");
                            current: Strings.duration(AppState.buffer-s);
                            value: AppState.buffer-s;
                            choices: [
                                { value: "15", label: Strings.duration(15) },
                                { value: "30", label: Strings.duration(30) },
                                { value: "45", label: Strings.duration(45) },
                                { value: "60", label: Strings.duration(60) },
                                { value: "90", label: Strings.duration(90) },
                                { value: "120", label: Strings.duration(120) },
                                { value: "180", label: Strings.duration(180) },
                                { value: "240", label: Strings.duration(240) },
                                { value: "300", label: Strings.duration(300) },
                                { value: "600", label: Strings.duration(600) },
                            ];
                            chosen(v) => { AppState.set-buffer(v.to-float()); }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: @tr("Delay buffer"); color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            min-height: 38px;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    label: @tr("Delay buffer");
                                    checked: AppState.delay-mode;
                                    toggled(on) => { AppState.set-delay-mode(on); }
                                }
                            }
                            Text {
                                text: AppState.delay-mode ? @tr("On: keeps the last minutes ready") : @tr("Off: no delay possible");
                                color: AppState.delay-mode ? Theme.text-secondary : Theme.warning;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: @tr("Buffer"); color: Theme.text-secondary; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
                        Text {
                            text: AppState.buffer-text;
                            color: AppState.ready ? Theme.text-primary : Theme.warning;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                    ProgressBar {
                        value: AppState.buffer-fill;
                        color: AppState.ready ? Theme.accent : Theme.warning;
                    }
                    if AppState.buffer-limit-s >= 0: Text {
                        text: @tr("At the current bitrate only about {} fit in memory; the buffer is limited to that.", Strings.duration(AppState.buffer-limit-s));
                        color: Theme.warning;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Toggle {
                        label: @tr("Start every stream with the delay on");
                        checked: AppState.delay-at-start;
                        enabled: AppState.delay-mode;
                        toggled(on) => { AppState.set-delay-at-start(on); }
                    }
                    Text {
                        text: @tr("Start every stream with the delay on");
                        color: Theme.text-primary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            StatCard { icon: Icons.signal; label: @tr("Bitrate"); value: AppState.bitrate-text; }
            StatCard { icon: Icons.clock; label: @tr("Uptime"); value: AppState.uptime-text; }
            StatCard { icon: Icons.buffer; label: @tr("Buffer"); value: AppState.buffer-text; }
            StatCard {
                icon: Icons.hourglass;
                label: @tr("Current delay");
                value: Strings.duration(AppState.current-delay-s);
            }
        }

        if AppState.state != "offline" && Strings.health-summary() != "": Text {
            text: Strings.health-summary();
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
        }

        if AppState.findings.length > 0: Card {
            border-color: Theme.warning.with-alpha(0.35);
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Image { source: Icons.warning; colorize: Theme.warning; width: 18px; height: 18px; }
                    SectionTitle { text: @tr("Stream health"); }
                }
                for f in AppState.findings: HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 5px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: f.severity == "high" ? Theme.error : f.severity == "medium" ? Theme.warning : Theme.text-secondary;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: Strings.finding-title(f.code); color: Theme.text-primary; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                        Body { text: Strings.finding-detail(f.code, f.value, f.limit); font-size: 12px; }
                    }
                }
            }
        }

        if AppState.streams.length > 1: Card {
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                SectionTitle { text: @tr("Live routes"); }
                for s in AppState.streams: HorizontalLayout {
                    spacing: 16px;
                    Text { text: s.route; color: Theme.text-primary; font-size: 13px; font-weight: 600; min-width: 120px; }
                    Text { text: Strings.state-label(s.phase); color: Theme.text-secondary; font-size: 13px; min-width: 90px; }
                    Text { text: s.bitrate; color: Theme.text-secondary; font-size: 13px; min-width: 90px; }
                    Text { text: s.delay; color: Theme.text-secondary; font-size: 13px; horizontal-stretch: 1; }
                }
            }
        }
    }
}
