// Setup: how to point an encoder at OpenDelay.

import { Theme } from "../theme.slint";
import { Button, Card, CopyField, Body, SectionTitle } from "../widgets.slint";
import { AppState } from "../state.slint";
import { RouteEditor } from "multistream.slint";

component Step {
    in property <int> n;
    in property <string> text;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent-muted;
                Text {
                    text: root.n;
                    color: Theme.accent-hover;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Body {
            text: root.text;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component SetupPage {
    VerticalLayout {
        spacing: 16px;
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                SectionTitle { text: @tr("Connect your encoder"); }
                Step { n: 1; text: @tr("In OBS open Settings → Stream, choose the service \"Custom…\" and paste the server URL of your platform:"); }
                // Routes that send another route's stream get no encoder.
                VerticalLayout {
                    spacing: 8px;
                    padding-left: 36px;
                    for r in AppState.routes: VerticalLayout {
                        if r.source == "": HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 120px;
                                text: r.name;
                                color: r.enabled ? Theme.text-primary : Theme.text-disabled;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            CopyField {
                                value: r.local-url;
                                label: r.name;
                                copied => { AppState.toast(@tr("Copied to the clipboard"), "success"); }
                            }
                        }
                    }
                }
                Step { n: 2; text: @tr("Keep your usual stream key from the platform: OpenDelay passes it on unchanged."); }
                Step { n: 3; text: @tr("In Settings → Output (Output Mode: Advanced) set the Keyframe Interval to 2 s and the rate control to CBR. With a custom server OBS no longer applies the platform's recommended settings: without this, Twitch viewers may see a black screen and the delay switches late."); }
                Step { n: 4; text: @tr("Start streaming in OBS. Change the delay on the Dashboard at any time."); }
                Body { text: @tr("Streamlabs: Settings → Stream → \"Custom Ingest\". Other encoders: a custom RTMP server with the same URL and settings."); }
                if AppState.listener-mode == "lan" && AppState.lan-addresses != "": Body {
                    text: @tr("From another computer on your network, replace 127.0.0.1 with {} and add ?key={} to the end of the server URL. OpenDelay refuses other computers without this key.", AppState.lan-addresses, AppState.lan-key);
                }
                if AppState.listener-mode == "lan": HorizontalLayout {
                    spacing: 12px;
                    CopyField {
                        value: "?key=" + AppState.lan-key;
                        label: @tr("Network access key");
                        copied => { AppState.toast(@tr("Copied to the clipboard"), "success"); }
                    }
                    Button {
                        text: @tr("New key");
                        clicked => { AppState.new-lan-key(); }
                    }
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                SectionTitle { text: @tr("Other platforms"); }
                Body { text: @tr("Not streaming to Twitch? Edit the Twitch route on the Multistream page. To stream to several platforms at once, add each one with its stream key: it sends the same stream, so OBS needs no change."); }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Add a platform");
                        clicked => { RouteEditor.add(); }
                    }
                }
            }
        }
    }
}
