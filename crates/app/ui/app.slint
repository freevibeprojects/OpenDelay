// Main window: sidebar navigation, pages, toasts, onboarding; plus the tray.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { NavItem, IconButton, Toast, Choice, Card, Button, ButtonKind } from "widgets.slint";
import { AppState, Strings, RouteItem, StreamItem, Finding, LogItem } from "state.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { MultistreamPage, RouteEditor, RouteEditorModal } from "pages/multistream.slint";
import { ControllersPage } from "pages/controllers.slint";
import { OverlayPage } from "pages/overlay.slint";
import { SetupPage, Onboarding } from "pages/setup.slint";
import { HelpPage } from "pages/help.slint";
import { SettingsPage } from "pages/settings.slint";

export { AppState, Strings, Theme, RouteItem, StreamItem, Finding, LogItem, Choice }

component Page inherits Rectangle {
    in property <bool> shown;
    in property <string> title;
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: Theme.normal; easing: ease-out; }
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        // title row
        HorizontalLayout {
            height: 64px;
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        sv := ScrollView {
            content-width: self.visible-width;
            content-height: content.preferred-height;
            content := VerticalLayout {
                y: root.shown ? 0 : 10px;
                width: sv.visible-width;
                animate y { duration: Theme.normal; easing: ease-out; }
                alignment: start;
                padding-bottom: 32px;
                padding-right: 6px;
                @children
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "OpenDelay";
    icon: Icons.logo;
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 940px;
    min-height: 620px;
    background: Theme.bg-base;
    default-font-family: "Inter";

    in-out property <int> page: 0;
    callback close-requested();

    // Slow drifting violet glow behind the content (disableable). It moves in
    // 2–3 px steps twice a second instead of a per-frame animation: on a soft,
    // faint glow the steps are invisible, and an idle window repaints twice a
    // second rather than at display rate (~1 % CPU instead of ~40 %).
    property <bool> animate-bg: AppState.background-animation && !Theme.reduce-motion;
    property <float> drift: 0;
    Rectangle {
        x: parent.width * (0.3 + 0.15 * sin(root.drift * 1deg));
        y: -parent.height * (0.25 + 0.1 * cos(root.drift * 0.7deg));
        width: parent.width * 0.9;
        height: parent.height * 0.9;
        background: @radial-gradient(circle, #7f63f01c 0%, #7f63f000 65%);
        visible: AppState.background-animation;
    }
    Timer {
        interval: 500ms;
        running: root.animate-bg;
        triggered => { root.drift += 1; }
    }

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 212px;
            background: Theme.bg-elevated;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border-subtle;
            }
            VerticalLayout {
                padding: 14px;
                padding-top: 20px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 22px;
                    spacing: 10px;
                    Image { source: Icons.logo; width: 30px; height: 30px; }
                    Text {
                        text: "OpenDelay";
                        color: Theme.text-primary;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                NavItem { icon: Icons.dashboard; text: @tr("Dashboard"); active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { icon: Icons.multistream; text: @tr("Multistream"); active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { icon: Icons.controllers; text: @tr("Controllers"); active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { icon: Icons.overlay; text: @tr("Overlay"); active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { icon: Icons.setup; text: @tr("Setup"); active: root.page == 4; clicked => { root.page = 4; } }
                Rectangle { height: 14px; }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                Rectangle { height: 10px; }
                NavItem { icon: Icons.help; text: @tr("Help"); active: root.page == 5; clicked => { root.page = 5; } }
                NavItem {
                    icon: Icons.settings;
                    text: @tr("Settings");
                    active: root.page == 6;
                    badge: AppState.update-available;
                    clicked => { root.page = 6; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 8px;
                    Text { text: "v" + AppState.version; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    if AppState.update-available: Rectangle {
                        height: 20px;
                        width: upd.preferred-width + 14px;
                        border-radius: 10px;
                        background: Theme.accent-muted;
                        upd := Text {
                            text: @tr("Update");
                            color: Theme.accent-hover;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.page = 6; }
                        }
                    }
                }
            }
        }

        // Pages
        Rectangle {
            horizontal-stretch: 1;
            Page { shown: root.page == 0; title: @tr("Dashboard"); DashboardPage { } }
            Page { shown: root.page == 1; title: @tr("Multistream"); MultistreamPage { } }
            Page { shown: root.page == 2; title: @tr("Controllers"); ControllersPage { } }
            Page { shown: root.page == 3; title: @tr("Overlay"); OverlayPage { } }
            Page { shown: root.page == 4; title: @tr("Setup"); SetupPage { } }
            Page { shown: root.page == 5; title: @tr("Help"); HelpPage { } }
            Page { shown: root.page == 6; title: @tr("Settings"); SettingsPage { } }
        }
    }

    // Floating help button
    IconButton {
        x: parent.width - self.width - 22px;
        y: parent.height - self.height - 22px;
        icon: Icons.help;
        label: @tr("Help");
        size: 42px;
        round: true;
        tint: Theme.accent-hover;
        visible: root.page != 5;
        clicked => { root.page = 5; }
    }

    // Toast: shown for each new AppState.toast(), hidden after 3.5 s.
    property <int> toast-serial: AppState.toast-serial;
    property <int> hidden-serial: 0;
    changed toast-serial => { toast-timer.restart(); }
    Toast {
        text: AppState.toast-text;
        kind: AppState.toast-kind;
        x: (parent.width - self.width) / 2;
        y: root.toast-serial != root.hidden-serial ? parent.height - self.height - 28px : parent.height + 20px;
        animate y { duration: Theme.normal; easing: ease-out; }
    }
    toast-timer := Timer {
        interval: 3500ms;
        running: false;
        triggered => {
            self.running = false;
            root.hidden-serial = root.toast-serial;
        }
    }

    if RouteEditor.open: RouteEditorModal {
        width: parent.width;
        height: parent.height;
    }

    if AppState.quitting: Rectangle {
        background: #000000b3;
        TouchArea { }
        Card {
            width: 420px;
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: @tr("Waiting for streams to end");
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 600;
                }
                Text {
                    text: @tr("OpenDelay no longer accepts encoders and quits as soon as the active streams stop (at most 10 seconds).");
                    color: Theme.text-secondary;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Quit now");
                        kind: ButtonKind.danger;
                        clicked => { AppState.quit-now(); }
                    }
                }
            }
        }
    }

    if AppState.onboarding-open: Onboarding {
        width: parent.width;
        height: parent.height;
        done => { root.page = 0; }
    }
}

// Tray icon with its menu (SPEC §8.2).
export component Tray inherits SystemTrayIcon {
    icon: Icons.logo;
    tooltip: "OpenDelay";
    in property <bool> delay-active;
    callback show-window();
    callback toggle-delay();
    callback go-live();
    callback emergency-stop();
    callback quit();
    clicked => { root.show-window(); }
    Menu {
        MenuItem { title: @tr("Show OpenDelay"); activated => { root.show-window(); } }
        MenuItem {
            title: root.delay-active ? @tr("Disable delay") : @tr("Enable delay");
            activated => { root.toggle-delay(); }
        }
        MenuItem { title: @tr("Go live"); enabled: root.delay-active; activated => { root.go-live(); } }
        MenuItem { title: @tr("Emergency stop"); activated => { root.emergency-stop(); } }
        MenuSeparator { }
        MenuItem { title: @tr("Quit"); activated => { root.quit(); } }
    }
}
